{
  "name": "cineflix-live-worker",
  "version": "1.0.0",
  "description": "CineFlix OTT Cloudflare Worker — MovieBox HLS resolver + live channel HLS proxy + mirror registry",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "node scripts/build.js",
    "bundle": "node scripts/build.js && npx esbuild src/index.js --bundle --format=esm --target=es2022 --outfile=dist/worker.js",
    "build": "node scripts/build.js && npx wrangler deploy --dry-run",
    "dev": "npx wrangler dev",
    "deploy": "node scripts/build.js && npx wrangler deploy",
    "tail": "npx wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^3.80.0"
  }
}
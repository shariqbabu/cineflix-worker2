# ==============================================================================
# 🎬 CineFlix Cloudflare Worker — Secrets & Environment Variables (.env.example)
# ==============================================================================
#
# Cloudflare Workers mein sensitive credentials deploy karne ke 2 tareeqe hote hain:
#
# 1. Local Testing ke liye:
#    Is file ko copy karke ".dev.vars" naam se save karein (wrangler dev ise padhta hai):
#    cp .env.example .dev.vars
#
# 2. Production Deployment ke liye:
#    Inhe Cloudflare Secrets ke roop mein add karein taaki code public hone par bhi safe rahein:
#    npx wrangler secret put APP_SECRET_KEY
#    npx wrangler secret put VPS_HOST_URL
#    npx wrangler secret put TMDB_API_KEY
#    npx wrangler secret put ADMIN_PIN
#
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VPS MultiProvider Backend & Failover
# ------------------------------------------------------------------------------
# MovieBox streams fail hone par worker is VPS backend par failover karta hai.
# MultiProvider (Nitro, VidSrc, 1xCinema, 4KHDHub) aur Cricket Scorecard yahan se aate hain.
VPS_HOST_URL=https://cineflix-ott.duckdns.org

# VPS Backend API Authentication Key (security middleware bypass ke liye)
# Match with APP_SECRET in moviebox-api .env
APP_SECRET_KEY=shrq6396827211&&shrq9808335538

# Master Admin PIN (cricket API aur admin endpoints ke liye)
ADMIN_PIN=cineflix2026

# ------------------------------------------------------------------------------
# 2. TMDB API Key (The Movie Database)
# ------------------------------------------------------------------------------
# IMDb ID / title se movie & series information aur poster dhoondhne ke liye.
# Get free API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=00cacd3458b56d5218cd6b85411cb547

# ------------------------------------------------------------------------------
# 3. Supabase Database & Auth (Optional)
# ------------------------------------------------------------------------------
# Dynamic channels aur pre-roll ads database connect karne ke liye.
SUPABASE_URL=https://exaorbbpvxnogpbvyayx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImV4YW9yYmJwdnhub2dwYnZ5YXl4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkxMjM4MDUsImV4cCI6MjEwNDY5OTgwNX0.mnV03xUfYtG5xFftaNNnkK_S7UkIGPLw5QTqcIf6aWs

# ------------------------------------------------------------------------------
# 4. 40+ Cloudflare Workers Equal Load Balancing CDN Pool
# ------------------------------------------------------------------------------
# HLS (.m3u8) aur DASH (.mpd) segments in sabhi workers par equally distribute hote hain.
# Comma-separated worker URLs without trailing slash.
CLOUDFLARE_WORKERS=https://live-cdn.clineflix-e0d.workers.dev,https://live-cdn.clineflix-73f.workers.dev,https://start.betadda.workers.dev,https://ig.betadda.workers.dev,https://live.clineflix-e0d.workers.dev,https://stream.clineflix-e0d.workers.dev,https://live-cdn-ott.clineflix-e0d.workers.dev,https://live.clineflix-73f.workers.dev,https://stream.clineflix-73f.workers.dev,https://cdn-ott.clineflix-73f.workers.dev,https://cdn.clineflix-73f.workers.dev,https://cineflix.betadda.workers.dev,https://cineflix.shrqbabu016.workers.dev,https://cineflix-cdn.shrqbabu016.workers.dev,https://live-cdn.shrqbabu016.workers.dev,https://stream-cdn.shrqbabu016.workers.dev,https://ott-cdn.shrqbabu016.workers.dev,https://cineflix-hls.shrqbabu016.workers.dev,https://cineflix-ott.shariqbabu134.workers.dev,https://cineflix.shariqbabu134.workers.dev,https://cdn-live.shariqbabu134.workers.dev,https://router.gemini-free.workers.dev,https://cdn-cine.gemini-free.workers.dev,https://stream-ott.gemini-free.workers.dev,https://ott-cdn.gemini-free.workers.dev,https://cineflix.gemini-free.workers.dev,https://live-cdn.shrq.workers.dev,https://cdn-live.shrq.workers.dev,https://cdn-ott.shrq.workers.dev,https://cineflix-cdn.shrq.workers.dev,https://cineflix.shrq.workers.dev,https://stream-cdn.flow04624.workers.dev,https://cineflix-ott.flow04624.workers.dev,https://cdn-cineflix.flow04624.workers.dev,https://live-cdn.flow04624.workers.dev,https://stream-cdn.flow04624.workers.dev,https://stream.cineflix-49a.workers.dev,https://bot.shariqbabu134.workers.dev

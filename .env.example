# ==============================================================================
# 🎬 CineFlix Cloudflare Worker — Secrets & Environment Variables (.env.example)
# ==============================================================================
#
# Production Deployment ke liye Cloudflare Dashboard (Settings > Variables and Secrets)
# ya Wrangler CLI se secrets add karein:
#    npx wrangler secret put APP_SECRET_KEY
#    npx wrangler secret put VPS_HOST_URL
#    npx wrangler secret put TMDB_API_KEY
#    npx wrangler secret put ADMIN_PIN
#
# ==============================================================================

# VPS MultiProvider Backend & Failover URL
VPS_HOST_URL=https://your-vps-backend.example.com

# VPS Backend API Authentication Key
APP_SECRET_KEY=your_app_secret_key_here

# Master Admin PIN
ADMIN_PIN=your_admin_pin_here

# The Movie Database (TMDb) API Key
TMDB_API_KEY=your_tmdb_api_key_here

# Supabase Database & Auth (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 40+ Cloudflare Workers Equal Load Balancing CDN Pool (Comma-separated)
CLOUDFLARE_WORKERS=https://worker1.workers.dev,https://worker2.workers.dev
